# YouTube Channel Agent - Environment Configuration

# Application
APP_NAME="YouTube Channel Agent"
DEBUG=True
PORT=8000

# Database (Default uses SQLite, or use PostgreSQL: postgresql://user:password@localhost:5432/ytagent)
DATABASE_URL="sqlite:///./app.db"

# Owner Identity
OWNER_LOGIN_SUBJECT="ayeshmantha@local"
ALLOWED_CHANNEL_ID="UC_DEMO_CHANNEL_001"

# Google Gemini API Key (for AI script, image, TTS generation)
GENAI_API_KEY=""

# YouTube Data API / OAuth Credentials (optional for local testing)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
OAUTH_REDIRECT_URI="http://localhost:8000/api/auth/youtube/callback"

# Budget Limits (USD)
API_MONTHLY_LIMIT=30.0
API_DAILY_LIMIT=3.0
PER_VIDEO_LIMIT=1.0

# Publishing Controls
PUBLIC_PUBLISHING_ENABLED=False
